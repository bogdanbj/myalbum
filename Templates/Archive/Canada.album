  <page no="9" title="50th anniv. of the Canadian Confederation. (1917)">
    <p style="date">1917</p>
    
		<space height="5" />
    <p style="headline">50th Anniversary of the Canadian Confederation</p>
    
		<row>
      <stamp width="38" height="26" title="" image="" i1="3c" i2="brown" i3="S 135" f1="" f2="THE FATHERS OF CONFEDERATION" f3="" />
    </row>

    <space height="10" />
    <p style="date">1927</p>
    
		<space height="3" />
    <p style="headline">60th Year of the Canadian Confederation</p>
    
		<row>
      <stamp width="22" height="26" title="" image="" i1="1c" i2="orange" i3="S 141" f1="" f2="SIR JOHN A. MACDONALD" f3="" />
      <stamp width="38" height="26" title="" image="" i1="2c" i2="green" i3="S 142" f1="" f2="THE FATHERS OF CONFEDERATION" f3="" />
      <stamp width="38" height="26" title="" image="" i1="3c" i2="brown carmine" i3="S 143" f1="" f2="PARLIAMENT BUILDING AT OTTAWA" f3="" />
      <stamp width="22" height="26" title="" image="" i1="5c" i2="violet" i3="S 144" f1="" f2="SIR WILFRID LAURIER" f3="" />
    </row>
    
    <space height="2" />
