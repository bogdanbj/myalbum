
	<styles>
    <!--  Colors can be specified by name or by RGB values (0-255, 0-255, 0-255).
					When using RGB values, the color attribute should be a tupple of 3 RGB values separated by commas.
					When using color names, the color attribute should be one of the following known names:
          
						AliceBlue						DarkOrchid					LavenderBlush						MidnightBlue			SeaShell
						AntiqueWhite				DarkRed							LawnGreen								MintCream					Sienna
						Aqua								DarkSalmon					LemonChiffon						MistyRose					Silver
						Aquamarine					DarkSeaGreen				LightBlue								Moccasin					SkyBlue
						Azure								DarkSlateBlue				LightCoral							NavajoWhite				SlateBlue
						Beige								DarkSlateGray				LightCyan								Navy							SlateGray
						Bisque							DarkTurquoise				LightGoldenrodYellow		OldLace						Snow
						Black								DarkViolet					LightGray								Olive							SpringGreen
						BlanchedAlmond			DeepPink						LightGreen							OliveDrab					SteelBlue
						Blue								DeepSkyBlue					LightPink								Orange						Tan
						BlueViolet					DimGray							LightSalmon							OrangeRed					Teal
						Brown								DodgerBlue					LightSeaGreen						Orchid						Thistle
						BurlyWood						Firebrick						LightSkyBlue						PaleGoldenrod			Tomato
						CadetBlue						FloralWhite					LightSlateGray					PaleGreen					Transparent
						Chartreuse					ForestGreen					LightSteelBlue					PaleTurquoise			Turquoise
						Chocolate						Fuchsia							LightYellow							PaleVioletRed			Violet
						Coral								Gainsboro						Lime										PapayaWhip				Wheat
						CornflowerBlue			GhostWhite					LimeGreen								PeachPuff					White
						Cornsilk						Gold								Linen										Peru							WhiteSmoke
						Crimson							Goldenrod						Magenta									Pink							Yellow
						Cyan								Gray								Maroon									Plum							YellowGreen
						DarkBlue						Green								MediumAquamarine				PowderBlue
						DarkCyan						GreenYellow					MediumBlue							Purple
						DarkGoldenrod				Honeydew						MediumOrchid						Red
						DarkGray						HotPink							MediumPurple						RosyBrown
						DarkGreen						IndianRed						MediumSeaGreen					RoyalBlue
						DarkKhaki						Indigo							MediumSlateBlue					SaddleBrown
						DarkMagenta					Ivory								MediumSpringGreen				Salmon
						DarkOliveGreen			Khaki								MediumTurquoise					SandyBrown
						DarkOrange					Lavender						MediumVioletRed					SeaGreen
    -->
    <!-- FRENCH CHARACTERS
			l'accent aigu (acute accent) – é
			l'accent grave (grave accent) – à, è, ù
			la cédille (cedilla) – ç
			l'accent circonflexe (circumflex) – â, ê, î, ô, û
			l'accent tréma (trema) – ë, ï, ü
			
			L'ACCENT AIGU (ACUTE ACCENT) – É
			L'ACCENT GRAVE (GRAVE ACCENT) – À, È, Ù
			LA CÉDILLE (CEDILLA) – Ç
			L'ACCENT CIRCONFLEXE (CIRCUMFLEX) – Â, Ê, Î, Ô, Û
			L'ACCENT TRÉMA (TREMA) – Ë, Ï, Ü
			-->
    <!-- ESCAPE CHARACTERS
			ampersand (&) is escaped to &amp; 
			double quotes (") are escaped to &quot; 
			single quotes (') are escaped to &apos; 
			less than (<) is escaped to &lt; 
			greater than (>) is escaped to &gt;
			-->
    <!-- WHITE ACE FONTS
			The story copy is Folio Lite, the Italic is Garamond Lite Italic, the Headline Type is Stymie Book and the Dates are Lubalin.
			-->
    <!--	UNITS: 
			all numeric values (margin, padding, vspace, x, y, width, height) are expressed in millimeters (mm). 
			-->

    <!-- PAGE
			orientation: portrait, landscape
			size: letter, A4
			margin: top, right, bottom, left
      
      note: only Row and Space can be roated so for landscape style, 
      you need the "CANADA" header to be in a <row> element
			-->
    <page style="cover" default="false" orientation="portrait" size="letter" margin="7" color="black" bgcolor="Ivory" vspace="1">
      <!--banner file-name="flag_of_canada.jpg" /-->
      <border style="page_border" />
    </page>

    <page style="portrait" default="true" orientation="portrait" size="letter" margin="7,7,7,22" color="black" bgcolor="Silver" vspace="1">
      <!--banner file-name="banner.jpg" height="20"  /-->
      <border style="page_border" />
      <row style="page_header">
        <text align="center" font-name="Century Gothic" font-size="12" font-style="bolditalic" bgcolor="LightSkyBlue">C   A   N   A   D   A</text>
      </row>
      <space height="10" />
      <!--space height="5" width="100%" /-->
    </page>

    <page style="landscape" default="false" orientation="landscape" size="letter" margin="22,7,7,7" color="black" bgcolor="Silver" vspace="1">
      <!--banner file-name="banner.jpg" rotate="true" height="20"  /-->
      <border style="page_border" rotate="true" margin="0,6,6,6"/>
      <row style="page_header" rotate="true">
        <text align="center" font-name="Century Gothic" font-size="12" font-style="bolditalic" bgcolor="LightSkyBlue">C   A   N   A   D   A</text>
      </row>
      <!--space height="5" width="100%" rotate="true"></space-->
      <space height="10"></space>
    </page>
    
    <!-- FRAME
			type: none, single, double, //white ace, //custom
			width: line1, space, line2
			margin: 4 values: top, right, bottom, left 
						  2 values: top-bottom, left-right
              1 value: all equal
      Margin is interior to the frame.
      alignment: inside, outside, //center 
			-->
		<frame style="stamp_frame" default="true" frame-type="double" frame-alignment="outside" frame-width="0.4, 0.4, 0.1" margin="2" color="48,48,48" bgcolor="255,255,255" />
    <frame style="page_border" default="false" frame-type="double" frame-alignment="outside" frame-width="0.5, 0.5, 0.2" margin="0,6" bgcolor="Ivory"/>
    <frame style="stamp_black_bg" default="false" frame-type="single" frame-alignment="inside" frame-width="3" margin="2" color="48,48,48" />

    <!-- TEXT
			font-size: double
			font-style: bold, bolditalic, italic, regular
			align: left, center, right
			valign: top, center, bottom
      Margin is exterior to the text.
			-->
    <text style="text_default" default="true" align="left" font-name="Century Gothic" font-size="8" font-style="regular" />
    <text style="date" align="center" font-name="Century Gothic" font-size="14" bgcolor="DarkSeaGreen"/>
    <text style="chapter" width ="100%" align="center" font-name="Century Gothic" font-style="italic" font-size="36"/>
    <text style="headline" align="center" font-name="Century Gothic" font-size="10" bgcolor="CadetBlue" margin="0,0,1,0"/>
    <text style="story" align="left" font-name="Century Gothic" font-size="8" wrap="true" bgcolor ="MediumAquamarine" />
    <text style="title" align="center" font-name="Century Gothic" font-size="10" bgcolor ="MediumAquamarine" />
    <text style="inside" align="center" font-name="Century Gothic" font-size="6" bgcolor="MediumAquamarine" />
    <text style="footer" font-name="Century Gothic" font-size="6" bgcolor="MediumAquamarine"/>
    <!--
    <text style="inside" align="center" font-name="Century Gothic" font-size="6" font-style="regular" width="80%"/>
    <text style="footer_left" align="left" font-name="Century Gothic" font-size="6" font-style="regular" margin="0,0,2,0" />
    <text style="footer_center" align="center" font-name="Century Gothic" font-size="6" font-style="regular" width="100%" margin="0,0,2,0" />
    <text style="footer_right" align="right" font-name="Century Gothic" font-size="6" font-style="regular" margin="0,0,2,0" />
		-->
		<!-- IMAGE
			Margin is exterior to the image. Width and height define the actual size of the image. 
      The space taken on paper is image width/height plus the margin.
			-->
		<image style="stamp_image" default="true" color="false" bgcolor="OliveDrab" />
    
    <!-- SPACE
			Has no margin. Any margin attribute is ignored.
			-->
		<space style="default_space" default="true" width="0" height="0" bgcolor="Transparent" bgcolor_2="LavenderBlush" />

    <!-- STAMP
			Width and height are the dimensions of the physical stamp. 
      Frame margin is added to width and height to define the size of the frame.
      Frame width defines the stamp width.The stamp height is given by title, frame footer an the space between them.
      Between title and frame and between frame and footer there is a space the size of vspace attribute.
      All texts (title, inside, footer) do not wrap.
      If image exists, it is pictured instead of inside text.
      There is no margin for a stamp.
			-->
		<stamp style="stamp_default" default="true" vspace="1" bgcolor ="SkyBlue">
			<frame style="stamp_frame" />
			<image style="image_default" />
			<title style="title" />
			<inside1 style="inside" />
			<inside2 style="inside" />
			<inside3 style="inside" />
			<footer1 style="footer" align="left" />
			<footer2 style="footer" align="center" />
			<footer3 style="footer" align="right" />
		</stamp>

    <!-- ROW
			spacing: FS (fixed space), ES (equal spacing), JS (justified spacing)
      Row spans horizontaly to the width of the parent's canvas. If width is given as an attribut, it is ignored.
      Margin is substracted from the total width.
      Row's height is determined by the height of the content plus the margin. 
      If height is given as an attribute, then the largest of the explicit value and the content is used.
			-->
		<row style="stamp_FS" default="true" align="center" valign="center" spacing-mode="FS" space="6" bgcolor="PaleGoldenrod"/>
		<row style="page_header" default="false" align="center" valign="top" spacing-mode="FS" space="8"  bgcolor="PaleGreen"/>

    <!-- COLUMN
			Column width must be specified, with the exception of the last column in the block. 
      If the last column does not have a width, it fills the remaining space.
      Column height is always 100% of the parent canvas.
      If columns are held in a Row without an height, then the row and the inside columns span vertically to the whole remaining page height. 
			-->
		<column style="default_column" default="true" align="center" vspace="1" bgcolor="SandyBrown"/>
		
  </styles>
