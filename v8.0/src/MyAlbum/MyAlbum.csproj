<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MyAlbum</RootNamespace>
    <AppConfig>App.$(Configuration).config</AppConfig>

    <!-- Versioning: Major.Minor fixed; bump BuildNumber by hand before each publish -->
    <MajorVersion>8</MajorVersion>
    <MinorVersion>0</MinorVersion>
    <BuildNumber>3</BuildNumber>
    <FileVersion>$(MajorVersion).$(MinorVersion).$(BuildNumber).0</FileVersion>
    <AssemblyVersion>$(MajorVersion).$(MinorVersion).0.0</AssemblyVersion>
    <Version>$(MajorVersion).$(MinorVersion).$(BuildNumber)</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Show both config sources under their real names in all configurations.
         The AppConfig property selects which one becomes MyAlbum.dll.config. -->
    <None Include="App.Debug.config" />
    <None Include="App.Release.config" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyAlbum.Common\MyAlbum.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.10" />
  </ItemGroup>

</Project>
